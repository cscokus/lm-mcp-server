# ── Incoming auth ─────────────────────────────────────────────────────────────
# The bearer token the MCP client (Claude connector / Claude Code) presents.
# Generate with `openssl rand -hex 32` and register the SAME value on the
# Claude side. NEVER commit the real value — this file is an example only.
MCP_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# ── CRM API (Liquid-Mind-CRM Express app) ─────────────────────────────────────
# Where the READ tools and the PROPOSE (AI_Action_Queue) tools send their calls.
# In production the MCP container shares the CRM's docker network, so use the
# service name; localhost only works when running outside docker.
CRM_BASE_URL=http://backend:3000
# Service credential the CRM accepts — MUST equal the CRM backend's
# MCP_SERVICE_TOKEN env var. Generate with `openssl rand -hex 32`.
CRM_SERVICE_TOKEN=replace-with-shared-service-secret

# ── WebPages PHP tools (LiquidMindWebPages) ───────────────────────────────────
# Reserved for the EXECUTE phase (Quick Campaign Tool, Audience Tool, ...).
# Not used by any v1 tool. Leave blank for now.
WEBTOOLS_BASE_URL=http://localhost
WEBTOOLS_SERVICE_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8930
